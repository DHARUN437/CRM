# Apache Configuration for Next.js CRM Subdomain (lawngreen-alpaca-627630.hostingersite.com)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not rewrite static files or directories that exist
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback to index.html for client-side routing
  RewriteRule ^ index.html [L]
</IfModule>

# Serve Android APK files with proper MIME type
AddType application/vnd.android.package-archive .apk

# Disable aggressive browser & mobile webview caching during testing phase
<IfModule mod_headers.c>
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires 0
</IfModule>

# Enable Gzip Compression for Fast Mobile Loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/json application/javascript text/javascript
</IfModule>
