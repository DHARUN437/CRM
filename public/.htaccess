# Apache Configuration for Next.js Subdomain (lawngreen-alpaca-627630.hostingersite.com)

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Route /login and /portal/login directly to index.html with query strings attached
  RewriteRule ^login/?$ index.html [QSA,L]
  RewriteRule ^portal/login/?$ index.html [QSA,L]

  # 2. Do not rewrite static files or directories that exist (images, js, css)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Fallback to index.html for all client-side SPA routing with Query String Append (QSA)
  RewriteRule ^ index.html [QSA,L]
</IfModule>

# Disable caching for HTML files during testing phase
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>

# Security headers (match next.config.mjs for the static-host path)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>

# Enable Gzip Compression for Fast Mobile Loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/json application/javascript text/javascript
</IfModule>
