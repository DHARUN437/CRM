# Apache Configuration for Next.js CRM Subdomain (lawngreen-alpaca-627630.hostingersite.com)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Explicitly route /login and /portal/login with query strings to index.html
  RewriteRule ^login$ index.html [QSA,L]
  RewriteRule ^portal/login$ index.html [QSA,L]

  # 2. Do not rewrite static files or directories that exist (images, js, css, download/JoyCRM.apk)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Fallback to index.html for all client-side routing with Query String Append (QSA)
  RewriteRule ^ index.html [QSA,L]
</IfModule>

# Serve Android APK files with proper MIME type
AddType application/vnd.android.package-archive .apk

# Selective Caching Rules:
# - HTML files & SPA entrypoints: NO CACHE (always fetch fresh HTML)
# - Next.js hashed static assets (/_next/static/): CACHE IMMUTABLE FOR 1 YEAR
<IfModule mod_headers.c>
  # Default for HTML/routes: No Cache
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Immutable caching for content-hashed Next.js JS/CSS chunks
  <FilesMatch "\.(js|css|woff2|woff|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Enable Gzip Compression for Fast Mobile Loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/json application/javascript text/javascript
</IfModule>
