# Apache Configuration for Next.js CRM Subdomain (lawngreen-alpaca-627630.hostingersite.com)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Explicitly route /login and /portal/login (with or without query parameters like ?next=...) directly to index.html
  RewriteRule ^login$ index.html [QSA,L]
  RewriteRule ^portal/login$ index.html [QSA,L]

  # Do not rewrite static files or directories that exist (images, js, css, download/JoyCRM.apk)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback to index.html for all client-side routing with Query String Append (QSA)
  RewriteRule ^ index.html [QSA,L]
</IfModule>

# Serve Android APK files with proper MIME type
AddType application/vnd.android.package-archive .apk

# Disable aggressive browser & mobile webview caching during testing phase
<IfModule mod_headers.c>
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires 0
</IfModule>

# Enable Gzip Compression for Fast Mobile Loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/json application/javascript text/javascript
</IfModule>
